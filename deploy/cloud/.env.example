# Meridian Cloud — copy to .env and fill in. Never commit .env.
#
# Your machine's Tailscale name (MagicDNS + HTTPS certificates enabled):
#   tailscale status --json | jq -r .Self.DNSName   (drop the trailing dot)
MERIDIAN_HOST=meridian.tail1234.ts.net

# Optional: your own domain (Cloudflare Tunnel; docs/CLOUD.md "Use your own
# domain"). Browsers, gateways and the installer use it; GPU nodes keep using
# https://$MERIDIAN_HOST:8443.
# MERIDIAN_PUBLIC_URL=https://meridian.example.com
# CLOUDFLARE_TUNNEL_TOKEN=

# Image tag (ghcr.io/imv-in/meridian-control). Pin a version in production.
MERIDIAN_VERSION=latest

# Who may create an account: "open" (anyone) or "invite" (only invited emails).
MERIDIAN_CONTROL_SIGNUP=invite
# Comma-separated emails that may sign up even when signup=invite (you).
MERIDIAN_CONTROL_ADMIN_EMAILS=you@example.com
# Optional: restrict sign-up to these email domains (comma-separated).
MERIDIAN_CONTROL_ALLOWED_EMAIL_DOMAINS=

# ── Sign in with Google (optional, free) ───────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI:
#   https://<MERIDIAN_HOST>/auth/google/callback  (or <MERIDIAN_PUBLIC_URL>/auth/google/callback)
MERIDIAN_CONTROL_GOOGLE_CLIENT_ID=
MERIDIAN_CONTROL_GOOGLE_CLIENT_SECRET=

# ── Email sign-in codes (free SMTP) ───────────────────────────────────────
# Gmail: smtp.gmail.com, 587, starttls, your address + a 16-character App
# Password (Google Account → Security → 2-Step Verification → App passwords).
# Brevo free tier: smtp-relay.brevo.com, 587, starttls, SMTP login + key.
# Leave SMTP_HOST empty to print codes in the container log (testing only).
MERIDIAN_CONTROL_SMTP_HOST=
MERIDIAN_CONTROL_SMTP_PORT=587
MERIDIAN_CONTROL_SMTP_SECURITY=starttls
MERIDIAN_CONTROL_SMTP_USERNAME=
MERIDIAN_CONTROL_SMTP_PASSWORD=
MERIDIAN_CONTROL_MAIL_FROM=Meridian <you@example.com>
